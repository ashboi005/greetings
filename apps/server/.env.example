# Copy to .env and fill in. Validated at boot by packages/env/src/server.ts —
# the process exits rather than starting with bad configuration.

# Sign with a real secret in any shared environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Change if 3000 is already taken on your machine.
PORT=3000

# Backed by docker-compose.dev.yml (`bun run db:up`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings

# Separate database so `bun test` can truncate freely without touching dev data.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings_test

# --- Mobile sign-in (spec §11.1) ---
# Firebase project whose ID tokens this server will accept. Leave unset for
# work that does not touch mobile auth; POST /v1/auth/firebase then returns a
# clear error instead of the server refusing to boot.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Web sign-in (spec §11.2) ---
# Designers, admins and super admins sign in with an email and password that a
# super admin created for them. Public sign-up is disabled, so there is no route
# to an account except an existing super admin making one.
#
# No Google credentials are needed for the panels. Google Sign-In requires an
# OAuth client and, to serve more than 100 people, a consent screen published to
# production — a form, not a review, but still a form and a privacy policy. It
# is left available for later: set both values and the provider registers itself.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Image storage (spec §6) ---
# Cloudflare R2. All four are needed together; without them the server still
# boots but designer upload endpoints report that storage is unconfigured.
# Create the bucket and an API token with Object Read & Write at
# https://dash.cloudflare.com → R2.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=greetings-content

# --- Bootstrap ---
# The first panel account. Nobody can create it from inside the product, because
# only a super admin can create accounts and there is not one yet:
#
#   bun run jobs create-admin
#
# Creates SUPER_ADMIN_EMAIL with SUPER_ADMIN_PASSWORD if no such account exists,
# or promotes it if it does. Sign in, change the password from the panel, then
# remove SUPER_ADMIN_PASSWORD — a standing password in a deployment config is a
# credential sitting somewhere it does not need to be.
# SUPER_ADMIN_PASSWORD=at-least-twelve-characters
# Promoted to super_admin by `bun run db:seed`. The account must already exist,
# so sign in once with Google first, then run the seed.
# SUPER_ADMIN_EMAIL=you@example.com

# --- Operational limits (spec §12) ---
# Turn on ONLY where a proxy in front of this server overwrites
# x-forwarded-for (a load balancer, Cloudflare, an ingress controller). Left
# off, the rate limiter uses the socket address. Turned on without such a
# proxy, any client can set the header itself and evade every per-address
# limit by changing it each request.
# TRUST_PROXY_HEADERS=false

# Postgres connections this instance holds. Multiply by the number of
# instances and keep the total under the server's max_connections.
# DATABASE_POOL_MAX=20

# Postgres cancels a statement that runs longer than this. Without a ceiling
# one slow query holds its connection indefinitely and the pool drains.
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Request bodies above this are refused before being read into memory. The
# largest legitimate body is a content description; images never pass through
# this server.
# MAX_REQUEST_BODY_BYTES=1048576
