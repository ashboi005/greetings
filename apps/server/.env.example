# Copy to .env and fill in. Validated at boot by packages/env/src/server.ts —
# the process exits rather than starting with bad configuration.

# Sign with a real secret in any shared environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Change if 3000 is already taken on your machine.
PORT=3000

# Backed by docker-compose.dev.yml (`bun run db:up`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings

# Separate database so `bun test` can truncate freely without touching dev data.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings_test

# --- Mobile sign-in (spec §11.1) ---
# Firebase project whose ID tokens this server will accept. Leave unset for
# work that does not touch mobile auth; POST /v1/auth/firebase then returns a
# clear error instead of the server refusing to boot.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Web sign-in (spec §11.2) ---
# Designers, admins and super admins sign in with an email and password that a
# super admin created for them. Public sign-up is disabled, so there is no route
# to an account except an existing super admin making one.
#
# No Google credentials are needed for the panels. Google Sign-In requires an
# OAuth client and, to serve more than 100 people, a consent screen published to
# production — a form, not a review, but still a form and a privacy policy. It
# is left available for later: set both values and the provider registers itself.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Image storage (spec §6) ---
# Cloudflare R2. All four are needed together; without them the server still
# boots but designer upload endpoints report that storage is unconfigured.
#
# Where each value comes from, at https://dash.cloudflare.com → R2:
#   R2_ACCOUNT_ID        Object Storage overview, right-hand panel. It is also
#                        the subdomain of the S3 endpoint it shows you:
#                        https://<account-id>.r2.cloudflarestorage.com
#   R2_BUCKET            The name you gave the bucket when you created it.
#   R2_ACCESS_KEY_ID     "Manage R2 API Tokens" → Create API token. Scope it to
#   R2_SECRET_ACCESS_KEY this one bucket with Object Read & Write. Create an *R2
#                        API token*, not a global API key. The secret is shown
#                        once, on creation, and never again.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=greetings-content
#
# The bucket also needs a CORS policy, which is easy to miss because nothing
# fails until a designer tries to upload. The browser PUTs the file straight to
# R2 — the API never sees the bytes — so R2 itself has to allow that origin.
# In the bucket's Settings → CORS policy:
#
#   [{ "AllowedOrigins": ["https://your-panel-domain"],
#      "AllowedMethods": ["PUT", "GET"],
#      "AllowedHeaders": ["content-type"],
#      "MaxAgeSeconds": 3600 }]
#
# Without it the presigned URL is issued correctly and the upload is refused by
# the browser, which reads as "upload failed" with nothing wrong server-side.
#
# --- Public CDN in front of the bucket ---
#
# R2_PUBLIC_BASE_URL is how the mobile app displays images. Without it, feed
# items carry a null imageUrl and there is nothing to render — the app cannot
# show a feed. It is optional only so that local development works.
#
# Setting it up, in the bucket's Settings → Public access:
#   1. Connect a custom domain, e.g. cdn.yourdomain.com. Use a custom domain,
#      not the r2.dev development URL: r2.dev is rate limited, is not meant for
#      production, and does not support image resizing.
#   2. That domain must be on a zone in the same Cloudflare account, which it
#      will be if your DNS is already there.
#   3. Set R2_PUBLIC_BASE_URL to it, with the scheme and no trailing path.
# R2_PUBLIC_BASE_URL=https://cdn.yourdomain.com
#
# Then enable image resizing on that zone: Cloudflare dashboard → the zone →
# Images → Transformations → "Resize images from any origin" (needs a paid
# plan). This is the step that is easy to skip and hard to notice: without it
# the transform is silently ignored, every thumbnail downloads the full-size
# original, and the feed is slow on exactly the connections this product exists
# to serve.
#
# Note the URL shape: transforms are a PATH PREFIX, not a query string.
# A ?width= query parameter does nothing at all.
#
#   https://cdn.yourdomain.com/cdn-cgi/image/width=100,format=auto/<some-key>
#
# Verify by comparing the two sizes — the second must be smaller:
#
#   curl -so /dev/null -w '%{size_download}\n' "https://cdn.yourdomain.com/<key>"
#   curl -so /dev/null -w '%{size_download}\n' "https://cdn.yourdomain.com/cdn-cgi/image/width=100,format=auto/<key>"
#
# If they are equal, transformations are not enabled on the zone.
#
# Making the bucket public is a deliberate trade. Anyone with an object key can
# fetch it without going through POST /v1/content/:id/download, so download
# counts are accurate for well-behaved clients rather than enforced. Cached,
# resizable images are worth more here than a counter nobody is attacking.

# --- Bootstrap ---
# The first panel account. Nobody can create it from inside the product, because
# only a super admin can create accounts and there is not one yet:
#
#   bun run jobs create-admin
#
# Creates SUPER_ADMIN_EMAIL with SUPER_ADMIN_PASSWORD if no such account exists,
# or promotes it if it does. Sign in, change the password from the panel, then
# remove SUPER_ADMIN_PASSWORD — a standing password in a deployment config is a
# credential sitting somewhere it does not need to be.
# SUPER_ADMIN_PASSWORD=at-least-twelve-characters
# Promoted to super_admin by `bun run db:seed`. The account must already exist,
# so sign in once with Google first, then run the seed.
# SUPER_ADMIN_EMAIL=you@example.com

# --- Operational limits (spec §12) ---
# Turn on ONLY where a proxy in front of this server overwrites
# x-forwarded-for (a load balancer, Cloudflare, an ingress controller). Left
# off, the rate limiter uses the socket address. Turned on without such a
# proxy, any client can set the header itself and evade every per-address
# limit by changing it each request.
# TRUST_PROXY_HEADERS=false

# Postgres connections this instance holds. Multiply by the number of
# instances and keep the total under the server's max_connections.
# DATABASE_POOL_MAX=20

# Postgres cancels a statement that runs longer than this. Without a ceiling
# one slow query holds its connection indefinitely and the pool drains.
# DATABASE_STATEMENT_TIMEOUT_MS=15000

# Request bodies above this are refused before being read into memory. The
# largest legitimate body is a content description; images never pass through
# this server.
# MAX_REQUEST_BODY_BYTES=1048576
