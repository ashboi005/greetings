# Copy to .env and fill in. Validated at boot by packages/env/src/server.ts —
# the process exits rather than starting with bad configuration.

# Sign with a real secret in any shared environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001

# Change if 3000 is already taken on your machine.
PORT=3000

# Backed by docker-compose.dev.yml (`bun run db:up`).
DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings

# Separate database so `bun test` can truncate freely without touching dev data.
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/greetings_test

# --- Mobile sign-in (spec §11.1) ---
# Firebase project whose ID tokens this server will accept. Leave unset for
# work that does not touch mobile auth; POST /v1/auth/firebase then returns a
# clear error instead of the server refusing to boot.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# --- Web sign-in (spec §11.2) ---
# Designers, admins and super admins sign in with Google. The provider is
# registered only when both values are present.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Bootstrap ---
# Promoted to super_admin by `bun run db:seed`. The account must already exist,
# so sign in once with Google first, then run the seed.
# SUPER_ADMIN_EMAIL=you@example.com
