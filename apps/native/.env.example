# The API. See packages/env/src/native.ts — this is the only variable the app takes.
EXPO_PUBLIC_SERVER_URL=http://localhost:3000

# No Firebase variables. app.config.ts reads google-services.json and
# GoogleService-Info.plist directly, so there is nothing here to keep in sync.
# Drop those two files in apps/native/ and you are done. See docs/firebase-setup.md.
