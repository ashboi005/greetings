# ---------------------------------------------------------------------------
# Runtime (bundled into the app). See packages/env/src/native.ts.
# ---------------------------------------------------------------------------

# The API. Production by default. On a phone, `localhost` is the phone itself —
# to use a dev server, put your machine's LAN IP here (http://192.168.x.y:3000).
EXPO_PUBLIC_SERVER_URL=https://greetings-api.ashwathsoni.dev

# Microsoft Clarity project id (clarity.microsoft.com → project → Settings).
# Unset = Clarity does not start.
EXPO_PUBLIC_CLARITY_PROJECT_ID=

# AdMob ad unit ids (AdMob → Apps → Ad units). Release builds only: dev builds
# always use Google's test units. Unset in a release build = test ads.
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ANDROID=
EXPO_PUBLIC_ADMOB_INTERSTITIAL_IOS=

# Linked from Profile → About. Required by both stores and by AdMob.
EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ---------------------------------------------------------------------------
# Build time (read by app.config.ts, baked into the native project).
# ---------------------------------------------------------------------------

# AdMob *app* ids — the ones with a `~`, not the unit ids with a `/`.
# Unset = Google's sample app ids, which only ever serve test ads.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=

# No Firebase variables. app.config.ts reads google-services.json and
# GoogleService-Info.plist directly. Those two files are gitignored: get them
# from the Firebase console (or from the project owner) and drop them in
# apps/native/. For EAS builds they are uploaded as file env vars — see
# docs/mobile-app.md §Building.
