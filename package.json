{
	"name": "greetings",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/bun": "^1.3.14",
			"better-auth": "1.6.25",
			"evlog": "^2.22.4",
			"lucide-react": "^1.27.0",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.7",
			"@tanstack/react-form": "^1.33.2",
			"@tailwindcss/postcss": "^4.3.3",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3",
			"tailwind-merge": "^3.6.0",
			"@better-auth/expo": "1.6.25"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "bun run --filter '*' dev",
		"build": "bun run --filter '*' build",
		"check-types": "bun run --filter '*' check-types",
		"dev:native": "bun run --filter native dev",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"test": "bun run --filter server test",
		"db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
		"db:down": "docker compose -f docker-compose.dev.yml down",
		"db:reset": "docker compose -f docker-compose.dev.yml down -v && bun run db:up",
		"db:push": "bun run --filter @greetings/db db:push",
		"db:studio": "bun run --filter @greetings/db db:studio",
		"db:generate": "bun run --filter @greetings/db db:generate",
		"db:migrate": "bun run --filter @greetings/db db:migrate",
		"db:migrate:test": "bun run --filter @greetings/db db:migrate:test",
		"db:seed": "bun run --filter @greetings/db db:seed",
		"docker:build": "docker compose build",
		"docker:up": "docker compose up -d --build",
		"docker:down": "docker compose down",
		"docker:logs": "docker compose logs -f",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@greetings/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@greetings/config": "workspace:*",
		"@types/bun": "catalog:",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.10"
}
