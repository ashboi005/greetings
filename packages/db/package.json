{
	"name": "@greetings/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./schema": {
			"default": "./src/schema/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:migrate": "drizzle-kit migrate",
		"db:migrate:test": "drizzle-kit migrate --config drizzle.test.config.ts",
		"db:seed": "bun run src/seed/run.ts"
	},
	"dependencies": {
		"@greetings/env": "workspace:*",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@greetings/config": "workspace:*",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"typescript": "^6.0.3"
	}
}
